{
  "name": "event-management-backend",
  "version": "1.0.1",
  "description": "Backend for Event Management and Booking System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "prestart": "npm run prisma:generate",
    "start": "node src/server.js",
    "test": "node --test",
    "payments:reconcile-phonepe": "node scripts/reconcile-phonepe-orders.mjs",
    "payments:reconcile-razorpay": "node scripts/reconcile-razorpay-orders.mjs",
    "payments:release-stale-checkouts": "node scripts/release-stale-checkout-reservations.mjs",
    "tickets:backfill": "node scripts/backfill-tickets.mjs",
    "tickets:check": "node scripts/check-tickets.mjs",
    "admin:set": "node scripts/set-admin.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "postinstall": "echo 'Install complete. Prisma generation runs through npm run prisma:generate/prestart for Azure compatibility.'"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "event",
    "management",
    "booking"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@prisma/client": "^6.19.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ics": "^3.8.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.2",
    "twilio": "^5.11.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
